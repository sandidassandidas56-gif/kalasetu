# Authentication
BETTER_AUTH_SECRET=replace-with-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=KalaSetu <noreply@your-verified-domain.com>

# Seller AI providers (server-only)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

